APP_NAME=PupWatch
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8 in Docker/production. Local development and tests fall back to SQLite
# (DB_CONNECTION=sqlite, DB_DATABASE=database/database.sqlite).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pupwatch
DB_USERNAME=pupwatch
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@pupwatch.dev"
MAIL_FROM_NAME="${APP_NAME}"

# --- PupWatch -----------------------------------------------------------------
# Web origin allowed to use the stateful (cookie) Sanctum session + CORS.
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=pupwatch_bot
TELEGRAM_WEBHOOK_SECRET=

CHECK_USER_AGENT="PupWatch/1.0 (+https://pupwatch.dev/about)"